---
const navItems = [
  { label: "News", href: "/news/" },
  { label: "About", href: "/about/" },
  { label: "Conduct", href: "/conduct/" },
  { label: "Contact", href: "/contact/" },
];

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);
---

<header class="border-b border-[var(--color-border)] bg-[var(--color-bg)]/80 backdrop-blur sticky top-0 z-50">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-3 flex items-center justify-between gap-4">
    <a href="/" class="flex items-center gap-3 group min-w-0">
      <img
        src="/images/CTSNL Icon.svg"
        alt=""
        width="32"
        height="32"
        class="block rounded-sm flex-none"
      />
      <span class="font-semibold tracking-tight text-white truncate">
        <span class="sm:hidden">CTS-NL</span>
        <span class="hidden sm:inline">
          Computer Technology Society NL
        </span>
      </span>
    </a>

    <nav class="flex items-center gap-1 text-sm">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class:list={[
              "px-2.5 py-1.5 rounded-md transition-colors",
              isActive(item.href)
                ? "text-white bg-[var(--color-surface-2)]"
                : "text-[var(--color-text-muted)] hover:text-white hover:bg-[var(--color-surface)]",
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
