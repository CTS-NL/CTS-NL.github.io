---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Not found">
  <section class="max-w-2xl mx-auto px-4 sm:px-6 py-24 text-center">
    <div class="text-7xl font-semibold text-white tracking-tight">404</div>
    <p class="mt-4 text-muted">
      Nothing here. Could be moved, could be gone, could never have existed.
    </p>
    <div class="mt-8 flex flex-wrap gap-3 justify-center">
      <a
        href="/"
        class="px-4 py-2.5 rounded-md bg-discord-500 hover:bg-discord-600 text-white font-medium transition-colors"
        >Home</a
      >
      <a
        href="/news/"
        class="px-4 py-2.5 rounded-md border border-border hover:border-dim text-white transition-colors"
        >News archive</a
      >
    </div>
  </section>
</BaseLayout>
