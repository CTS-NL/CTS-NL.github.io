root = true

# Defaults match oxfmt: 2-space indent, LF line endings, final newline.
[*]
indent_style = space
indent_size = 2
end_of_line = lf
insert_final_newline = true
charset = utf-8
trim_trailing_whitespace = true

# Don't trim trailing whitespace in Markdown — two trailing spaces is a
# meaningful line break.
[*.md]
trim_trailing_whitespace = false
