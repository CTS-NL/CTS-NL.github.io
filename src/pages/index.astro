---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { DISCORD_INVITE_LINK } from "../lib/links";
import { formatShortDate } from "../lib/dates";

const posts = (await getCollection("posts"))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 4);

function postUrl(id: string) {
  const m = id.match(/^(\d{4})\/(\d{2})\/(\d{2})-(.+)$/);
  if (!m) return `/news/${id}/`;
  const [, y, mo, d, slug] = m;
  return `/news/${y}/${mo}/${d}/${slug}/`;
}
---

<BaseLayout>
  <!-- Hero -->
  <section class="border-b border-[var(--color-border)]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 pt-16 pb-12 sm:pt-24 sm:pb-16">
      <div class="max-w-3xl">
        <h1
          class="text-4xl sm:text-5xl font-semibold text-white leading-tight tracking-tight"
        >
          Software people in Newfoundland and Labrador.
        </h1>
        <p class="mt-5 text-lg text-[var(--color-text-muted)] leading-relaxed">
          <span class="text-white">Thursdays from 7pm</span> we meet up to work on
          whatever.<br />The rest of the week we're on Discord.
        </p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a
            href={DISCORD_INVITE_LINK}
            class="inline-flex items-center gap-2 px-4 py-2.5 rounded-md bg-[var(--color-discord-500)] hover:bg-[var(--color-discord-600)] text-white font-medium transition-colors"
          >
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                d="M20.317 4.37a19.79 19.79 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.058a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.331c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"
              ></path>
            </svg>
            Join the Discord
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Meetup info -->
  <section class="border-b border-[var(--color-border)]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 py-10">
      <div class="grid lg:grid-cols-2 gap-8 lg:gap-10 items-start">
        <div>
          <h2 class="text-2xl font-semibold text-white mb-4">Project Night</h2>
          <div class="space-y-3 text-[var(--color-text-muted)] leading-relaxed">
            <p>
              <span class="text-white font-medium">Thursdays, 7pm onwards.</span
              >
              <span class="text-white">Jumping Bean Coffee</span> on Elizabeth Avenue.
            </p>
            <p>
              Bring a laptop and work on something, or just hang out. People
              stick around until the cafe closes.
            </p>
            <p>
              If you're planning on going, check the Discord beforehand, as
              sometimes the cafe closes early, and we might meet up elsewhere.
            </p>
          </div>
        </div>
        <div>
          <img
            src="/og/every-thursday.png"
            alt="CTS-NL Meetup · Every Thursday at 7pm onwards at Jumping Bean Coffee on Elizabeth Avenue"
            width="1200"
            height="630"
            class="w-full rounded-lg border border-[var(--color-border)]"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="border-t border-[var(--color-border)]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 py-10">
      <p class="text-sm text-[var(--color-text-muted)] leading-relaxed">
        Looking for other tech events or jobs around St. John's?
        <a href="https://siliconharbour.dev" class="link-inline text-white"
          >siliconharbour.dev</a
        >
        is a community-run directory that tracks both.
      </p>
    </div>
  </section>

  <!-- Latest news -->
  <section>
    <div class="max-w-5xl mx-auto px-4 sm:px-6 py-12">
      <div class="flex items-baseline justify-between mb-5">
        <h2 class="text-lg font-medium text-white">Latest news</h2>
        <a
          href="/news/"
          class="text-sm text-[var(--color-text-muted)] hover:text-white"
        >
          All news →
        </a>
      </div>
      <ol class="news-graph">
        {
          posts.map((post, i) => (
            <li class="news-graph__row">
              <span
                class:list={[
                  "news-graph__node",
                  i === 0 && "news-graph__node--head",
                ]}
                aria-hidden="true"
              />
              <a
                href={postUrl(post.id)}
                class="group flex items-baseline gap-4 py-3 pr-2 pl-6 -mr-2 rounded flex-wrap hover:bg-[var(--color-surface)] transition-colors"
              >
                <time
                  datetime={post.data.date.toISOString()}
                  class="text-xs text-[var(--color-text-dim)] font-mono shrink-0 w-24"
                >
                  {formatShortDate(post.data.date)}
                </time>
                <span class="text-white">{post.data.title}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <style>
    /*
     * News list styled like a git commit graph. Echoes the line-and-square
     * motif in the CTS-NL logo. The connecting line runs from the HEAD node
     * down past the last node, then fades out to imply "more commits below"
     * (linking to /news/ for the full archive).
     */
    .news-graph {
      position: relative;
      list-style: none;
      padding: 0;
      margin: 0;
    }
    .news-graph::before {
      content: "";
      position: absolute;
      top: 0;
      left: 7px;
      width: 2px;
      transform: translateX(-50%);
      /* Run the full height of the list, then fade once we pass the last row. */
      height: calc(100% + 2.5rem);
      background: linear-gradient(
        to bottom,
        #6b6b6b 0%,
        #6b6b6b calc(100% - 4rem),
        rgba(107, 107, 107, 0) 100%
      );
      z-index: 0;
    }
    .news-graph__row {
      position: relative;
    }
    .news-graph__node {
      position: absolute;
      left: 7px;
      top: 50%;
      width: 9px;
      height: 9px;
      transform: translate(-50%, -50%);
      background: var(--color-text);
      border-radius: 1px;
      z-index: 1;
    }
    .news-graph__node--head {
      width: 15px;
      height: 15px;
    }
  </style>
</BaseLayout>
